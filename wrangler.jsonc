{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auradash-backend",
	"main": "backend/src/index.ts",
	"compatibility_date": "2026-04-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"CLOUDFLARE_API_TOKEN": "your_cloudflare_api_token_here",
		"CF_ACCOUNT_ID": "your_cloudflare_account_id_here",
		"AURADASH_MASTER_SECRET": "your_custom_master_crypto_secret_here",
		"R2_PUBLIC_URL": "https://pub-xxxxxx.r2.dev",
		"ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001",
		"EMAIL_FROM_ADDRESS": "noreply@yourdomain.com",
		"APP_FRONTEND_URL": "http://localhost:3000"
	},
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "auradash-storage",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auradash",
			"database_id": "YOUR_DATABASE_ID_HERE",
			"migrations_dir": "backend/migrations"
		}
	],
	"send_email": [
		{
			"name": "EMAILER",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "K1",
			"id": "YOUR_KV_NAMESPACE_ID_HERE",
			"preview_id": "YOUR_KV_NAMESPACE_ID_HERE",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "PUBLIC_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 25,
				"period": 60
			}
		},
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			"name": "DASHBOARD_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "LOGIN_RECOVERY_LIMITER",
			"namespace_id": "1005",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "VERIFY_CODE_LIMITER",
			"namespace_id": "1006",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "STATE_LIMITER",
			"namespace_id": "1007",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "NOTIFICATIONS_LIMITER",
			"namespace_id": "1008",
			"simple": {
				"limit": 40,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_SUBMISSION_LIMITER",
			"namespace_id": "1009",
			"simple": { "limit": 2, "period": 60 }
		},
		{
			"name": "FILES_LIMITER",
			"namespace_id": "1010",
			"simple": { "limit": 200, "period": 60 }
		},
		{
			"name": "HEALTH_LIMITER",
			"namespace_id": "1011",
			"simple": { "limit": 30, "period": 60 }
		}
	]
}
