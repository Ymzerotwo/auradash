{
  "name": "auradash-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/cf-setup.js && wrangler pages deploy .open-next --project-name auradash",
    "deploy:cloudflare": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/cf-setup.js && wrangler pages deploy .open-next --project-name auradash",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.11.0",
    "next": "14.2.15",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.20.0",
    "eslint-config-next": "14.2.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.119.0"
  },
  "allowScripts": {
    "msw": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "overrides": {
    "postcss": "^8.5.21",
    "sharp": "^0.35.0",
    "ws": "^8.20.1",
    "undici": "^7.28.1"
  }
}
