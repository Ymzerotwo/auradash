{
  "name": "auradash-backend",
  "version": "1.0.0",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply auradash --remote && wrangler deploy --minify",
    "db:init": "npx tsx src/db/init_db.ts",
    "db:remote": "npx tsx src/db/init_db.ts --remote",
    "db:reset": "npx tsx src/db/init_db.ts --reset-remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@types/sanitize-html": "^2.16.1",
    "cloudflare": "^6.3.0",
    "hono": "^4.12.15",
    "sanitize-html": "^2.17.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.35.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  },
  "overrides": {
    "undici": "^7.28.1"
  }
}
