{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auradash-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "auradash-storage",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auradash",
			"database_id": "your_d1_database_id_here"
		}
	],
	"send_email": [
		{
			"name": "EMAILER",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "K1",
			"id": "your_kv_namespace_id_here",
			"preview_id": "your_kv_preview_id_here",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "PUBLIC_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 25,
				"period": 60
			}
		},
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},

		{
			"name": "DASHBOARD_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "LOGIN_RECOVERY_LIMITER",
			"namespace_id": "1005",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "VERIFY_CODE_LIMITER",
			"namespace_id": "1006",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "STATE_LIMITER",
			"namespace_id": "1007",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "NOTIFICATIONS_LIMITER",
			"namespace_id": "1008",
			"simple": {
				"limit": 40,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_SUBMISSION_LIMITER",
			"namespace_id": "1009",
			"simple": { "limit": 2, "period": 60 }
		},
		{
			"name": "FILES_LIMITER",
			"namespace_id": "1010",
			"simple": { "limit": 200, "period": 60 }
		},
		{
			"name": "HEALTH_LIMITER",
			"namespace_id": "1011",
			"simple": { "limit": 30, "period": 60 }
		}
	]
}
