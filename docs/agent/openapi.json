{
  "openapi": "3.0.3",
  "info": {
    "title": "AuraDash Public API",
    "description": "Stateless, read-heavy Public RESTful API for consuming articles, services, settings, and submitting inquiries/comments.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://<your-worker>.workers.dev/api/public",
      "description": "Production Worker Endpoint"
    },
    {
      "url": "http://localhost:8787/api/public",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/articles": {
      "get": {
        "summary": "Get paginated standalone articles",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 12 } },
          { "name": "article_category_id", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Articles retrieved successfully" },
          "401": { "description": "Missing or invalid API key" }
        }
      }
    },
    "/articles/all": {
      "get": {
        "summary": "Get all published articles including category-linked",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 12 } }
        ],
        "responses": { "200": { "description": "All articles retrieved" } }
      }
    },
    "/articles/count": {
      "get": {
        "summary": "Get total count of standalone published articles",
        "responses": { "200": { "description": "Standalone articles count retrieved" } }
      }
    },
    "/articles/count/all": {
      "get": {
        "summary": "Get total count of all published articles",
        "responses": { "200": { "description": "Total articles count retrieved" } }
      }
    },
    "/articles/{slug}": {
      "get": {
        "summary": "Get single article by slug",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Article detail retrieved" },
          "404": { "description": "Article not found" }
        }
      }
    },
    "/articles/{slug}/comments": {
      "get": {
        "summary": "Get approved comments for an article",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Comments retrieved" } }
      }
    },
    "/article-categories": {
      "get": {
        "summary": "Get article categories",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Article categories retrieved" } }
      }
    },
    "/article-categories/count": {
      "get": {
        "summary": "Get count of active article categories",
        "responses": { "200": { "description": "Categories count retrieved" } }
      }
    },
    "/article-categories/{slug}": {
      "get": {
        "summary": "Get article category detail by slug",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Category detail retrieved" } }
      }
    },
    "/article-categories/{slug}/articles": {
      "get": {
        "summary": "Get articles under specific category",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 12 } }
        ],
        "responses": { "200": { "description": "Category articles retrieved" } }
      }
    },
    "/article-categories/{slug}/articles/count": {
      "get": {
        "summary": "Get article count under specific category",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Category article count retrieved" } }
      }
    },
    "/services": {
      "get": {
        "summary": "Get active standalone services",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Services retrieved" } }
      }
    },
    "/services/all": {
      "get": {
        "summary": "Get all services including category-linked",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "All services retrieved" } }
      }
    },
    "/services/{slug}": {
      "get": {
        "summary": "Get service detail by slug",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Service detail retrieved" } }
      }
    },
    "/service-categories": {
      "get": {
        "summary": "Get service categories",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Service categories retrieved" } }
      }
    },
    "/service-categories/{slug}": {
      "get": {
        "summary": "Get service category by slug",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Service category detail retrieved" } }
      }
    },
    "/service-categories/{slug}/services": {
      "get": {
        "summary": "Get services under specific category",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Category services retrieved" } }
      }
    },
    "/booking/services": {
      "get": {
        "summary": "Get lean active services for booking dropdowns",
        "responses": { "200": { "description": "Lean booking services list" } }
      }
    },
    "/booking/service-categories": {
      "get": {
        "summary": "Get lean active service categories for dropdowns",
        "responses": { "200": { "description": "Lean booking categories list" } }
      }
    },
    "/booking/service-categories/{slug}/services": {
      "get": {
        "summary": "Get lean services under specific category for booking",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Lean booking services retrieved" } }
      }
    },
    "/inbox": {
      "post": {
        "summary": "Submit contact message or service booking request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["full_name", "phone", "email", "inquiry_type", "message"],
                "properties": {
                  "full_name": { "type": "string", "minLength": 2, "maxLength": 255 },
                  "phone": { "type": "string", "minLength": 8, "maxLength": 255 },
                  "email": { "type": "string", "format": "email" },
                  "inquiry_type": { "type": "string", "enum": ["general", "service", "offer"] },
                  "service_id": { "type": "string", "format": "uuid" },
                  "message": { "type": "string", "minLength": 3, "maxLength": 10000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message submitted successfully" },
          "400": { "description": "Validation error or service not found" },
          "429": { "description": "Rate limit exceeded (RATE_LIMIT_EXCEEDED)" }
        }
      }
    },
    "/comments": {
      "post": {
        "summary": "Submit visitor comment on published article",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["article_id", "user_name", "user_email", "content"],
                "properties": {
                  "article_id": { "type": "string", "format": "uuid" },
                  "user_name": { "type": "string", "maxLength": 100 },
                  "user_email": { "type": "string", "format": "email" },
                  "content": { "type": "string", "minLength": 1, "maxLength": 3000 },
                  "parent_id": { "type": "string", "format": "uuid", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Comment submitted for moderation" },
          "400": { "description": "Validation error" },
          "404": { "description": "Article not found" }
        }
      }
    },
    "/settings": {
      "get": {
        "summary": "Get global business identity & settings",
        "responses": { "200": { "description": "Settings fetched successfully" }, "429": { "description": "Rate limit exceeded (RATE_LIMIT_EXCEEDED)" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  }
}
