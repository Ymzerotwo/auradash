{
  "openapi": "3.0.3",
  "info": {
    "title": "AuraDash Public API",
    "description": "Stateless, read-heavy Public RESTful API for consuming articles, services, settings, and submitting inquiries/comments.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.yourdomain.com/api/public",
      "description": "Production Worker Endpoint"
    },
    {
      "url": "http://localhost:8787/api/public",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "SeoData": {
        "type": "object",
        "properties": {
          "meta_title": {
            "type": "string"
          },
          "meta_description": {
            "type": "string"
          },
          "og_image": {
            "type": "string",
            "format": "uri"
          },
          "canonical_url": {
            "type": "string",
            "format": "uri"
          },
          "is_indexable": {
            "type": "boolean"
          }
        }
      },
      "MetaDataField": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "Article": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "author_name": {
            "type": "string",
            "nullable": true
          },
          "excerpt": {
            "type": "string",
            "nullable": true
          },
          "preview_image_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "reading_time_minutes": {
            "type": "integer",
            "nullable": true
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "category_name": {
            "type": "string",
            "nullable": true
          },
          "category_slug": {
            "type": "string",
            "nullable": true
          },
          "seo_data": {
            "$ref": "#/components/schemas/SeoData"
          },
          "meta_data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaDataField"
            }
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_name": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "parent_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "seo_data": {
            "$ref": "#/components/schemas/SeoData"
          },
          "meta_data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaDataField"
            }
          }
        }
      },
      "LeanService": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "parent_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "siteName": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "contactInfo": {
            "type": "object"
          },
          "socialMedia": {
            "type": "object"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "workingHours": {
            "type": "object"
          },
          "currency": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "API Key missing or invalid (API_KEY_MISSING, INVALID_API_KEY)"
      },
      "403": {
        "description": "Domain mismatch (DOMAIN_MISMATCH)"
      },
      "404": {
        "description": "Resource not found (ARTICLE_NOT_FOUND, SERVICE_NOT_FOUND, CATEGORY_NOT_FOUND)"
      },
      "429": {
        "description": "Rate limit exceeded (RATE_LIMIT_EXCEEDED)"
      },
      "500": {
        "description": "Internal server error (INTERNAL_SERVER_ERROR)"
      }
    }
  },
  "paths": {
    "/articles": {
      "get": {
        "summary": "Get paginated standalone articles",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 12
            }
          },
          {
            "name": "article_category_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Articles retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "code": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "articles": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      }
    },
    "/articles/all": {
